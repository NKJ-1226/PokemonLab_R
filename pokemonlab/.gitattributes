/mvnw text eol=lf
# テキストファイルの改行コードをLFに統一
* text=auto eol=lf

# ソースコード
*.java text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.csv text eol=lf

# Windows用スクリプトはCRLFを維持
*.bat text eol=crlf
*.cmd text eol=crlf

# バイナリファイルは変換しない
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.woff binary
*.woff2 binary